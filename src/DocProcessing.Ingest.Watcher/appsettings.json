{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "MassTransit": "Information",
        "DocProcessing.Ingest.Watcher": "Information"
      }
    }
  },
  "Watcher": {
    "DebounceMs": 500,
    "Filter": "*.tif",
    "IncludeSubdirectories": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}
